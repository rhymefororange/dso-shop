# Скопіюйте у .env (файл .env не потрапляє в git) і заповніть значення.
# docker compose автоматично передає змінні з .env у контейнер застосунку.

# Ключ підпису токенів доступу (JWT). Без нього генерується тимчасовий ключ.
SECRET_KEY=
# Пароль облікового запису admin (без нього вхід адміністратора вимкнено).
DSO_ADMIN_PASSWORD=
# Інтеграція з навчальним платіжним шлюзом DSOPay.
PAYMENT_GATEWAY_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Пошта (необов'язково).
SMTP_HOST=
SMTP_PORT=587
# Пароль PostgreSQL для docker compose (за замовчуванням dso-local-dev).
POSTGRES_PASSWORD=
